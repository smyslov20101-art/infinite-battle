/// Create Event - obj_curse
depth = -4;

// Параметры проклятья
damage_mult = 20;   // +20% получаемого урона
duration = 4;        // Длительность 4 секунды
max_targets = 3;     // Максимум 3 цели

// Счетчик пораженных врагов (ВАЖНО: инициализируем!)
enemies_hit = 0;

// Таймер самоуничтожения (живёт 1 секунду, за это время успевает наложить эффект)
alarm[0] = room_speed; // 60 кадров при 60 FPS = 1 секунда