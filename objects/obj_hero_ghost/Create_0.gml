// Create Event - obj_hero_ghost
// ===== ПРИЗРАК ГЕРОЯ ДЛЯ УЛУЧШЕНИЙ =====

// Наследуем базовые переменные
scr_hero_base_init(id);

// Переопределяем характеристики
is_ghost = true;              // Флаг призрака
max_hp = 1;                   // 1 HP чтобы не убили
hp = 1;
damage = 0;                   // Не наносит урон
move_speed = 4;               // Быстрее обычного героя
side = "";
// Целевой герой для слияния
target_hero = noone;          // ID героя, к которому идем

// Данные улучшения
upgrade_type = "";            // "hp" или "damage"
upgrade_value = 0;            // Значение бонуса (20, 30, 50...)
upgrade_level = 0;            // Уровень улучшения (для статистики)

// Визуал
image_alpha = 0.7;            // Полупрозрачный
image_blend = c_white;        // Можно сделать белым или цветным

// Состояние
state = STATE_MOVING;

// В Draw Event можно сделать полупрозрачным или с эффектом